{
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "prettier.config.js", "vite.config.ts"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Type safety — maximal. Every flag here catches a class of real bug
       (undefined array reads, unhandled switch branches, silently optional
       properties) and the agent is expected to satisfy all of them. */
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": true,

    /* AGENT CALIBRATION (deliberate, do not "fix"): unused locals and
       parameters are NOT errors. An agent mid-edit routinely leaves a
       momentarily unused import or a placeholder parameter; failing the
       typecheck on cosmetics would stall real work, while every flag above
       — the ones that catch actual defects — stays fatal. Lint handles
       unused code as a warning instead. */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
